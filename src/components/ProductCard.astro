---
import type { Product } from '../data/products';
import { categoryLabels } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article
  class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-stone-200/80 bg-white shadow-[0_2px_12px_rgba(28,25,23,0.035)] transition duration-300 hover:border-stone-300 hover:shadow-[0_8px_24px_rgba(28,25,23,0.08)]"
  data-product-category={product.category}
>
  <div class="relative aspect-square overflow-hidden bg-stone-100">
    <img
      src={product.imageUrl}
      alt={product.title}
      class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.03]"
      loading="lazy"
      width="900"
      height="900"
    />
    {product.badge && (
      <span class="absolute left-2.5 top-2.5 rounded-full border border-white/60 bg-white/90 px-2.5 py-1 text-[10px] font-medium text-stone-800 shadow-sm backdrop-blur sm:left-3 sm:top-3 sm:px-3 sm:text-xs">
        {product.badge}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <p class="text-[10px] font-medium uppercase tracking-[0.12em] text-stone-500 sm:text-xs">{categoryLabels[product.category]}</p>
    <h2 class="mt-1.5 line-clamp-2 min-h-10 text-xs font-medium leading-5 text-stone-900 sm:mt-2 sm:min-h-12 sm:text-sm sm:leading-6">
      {product.title}
    </h2>
    <p class="mt-2 text-sm font-bold text-stone-950 sm:mt-3 sm:text-base">{product.priceLabel}</p>
    <a
      href={product.shopeeUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex min-h-10 items-center justify-center rounded-lg bg-stone-900 px-2.5 py-2 text-center text-[11px] font-medium text-white transition-colors hover:bg-stone-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-500 focus-visible:ring-offset-2 sm:mt-4 sm:min-h-11 sm:px-4 sm:text-sm"
    >
      Cek Harga di Shopee <span aria-hidden="true" class="ml-1">↗</span>
    </a>
  </div>
</article>
