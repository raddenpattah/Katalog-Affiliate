---
import { getCollection, render } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categoryLabels } from '../../data/categories';
import { products } from '../../data/products';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const recommendedProducts = post.data.productIds.map((productId) => {
  const product = products.find(({ id }) => id === productId);

  if (!product) {
    throw new Error(`Blog post "${post.id}" references unknown product "${productId}".`);
  }

  return product;
});
const recommendedProductIds = new Set(recommendedProducts.map(({ id }) => id));
const otherProducts = products.filter(({ id }) => !recommendedProductIds.has(id));
const additionalProducts = [
  ...otherProducts.filter(({ category }) => category === post.data.category),
  ...otherProducts.filter(({ category }) => category !== post.data.category),
];
const dateFormatter = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="p:domain_verify" content="63cbf7dea4ba5f9335e79eecc975eb9a" />
    <meta name="description" content={post.data.description} />
    <title>{post.data.title} | Alfeto — Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic</title>
    <meta property="og:image" content={post.data.heroImage} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Alfeto" />
    <meta property="og:title" content={`${post.data.title} | Alfeto`} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:locale" content="id_ID" />
  </head>
  <body id="top" class="min-h-screen bg-[#faf9f6] font-sans antialiased text-gray-900">
    <Header />

    <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <article class="overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-[0_18px_60px_-35px_rgba(18,18,18,0.42)]">
        <header class="px-4 pb-8 pt-6 sm:px-8 sm:pb-9 sm:pt-8">
          <div class="flex items-center justify-between gap-4 border-b border-stone-200 pb-5">
            <p class="inline-flex items-center rounded-full border border-[#d7bb72]/60 bg-[#f4efe8] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#5c534d] sm:text-[11px]">
              {categoryLabels[post.data.category]}
            </p>
            <p class="text-[11px] text-stone-500 sm:text-xs">
              {dateFormatter.format(post.data.pubDate)} · {post.data.author}
            </p>
          </div>

          <h1 class="mt-6 text-3xl font-medium leading-[1.05] tracking-[-0.04em] text-stone-900 sm:text-5xl">
            {post.data.title}
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-stone-600 sm:text-lg">
            {post.data.description}
          </p>
          <img
            src={post.data.heroImage}
            alt={`Inspirasi ${post.data.category.toLowerCase()} — ${post.data.title}`}
            class="mt-8 aspect-[4/3] w-full rounded-[1.6rem] border border-stone-200 object-cover shadow-soft sm:aspect-[16/9]"
            width="1200"
            height="900"
          />
        </header>
        <div class="px-4 pb-8 sm:px-8 sm:pb-10">
          <div class="article-shell prose prose-stone max-w-none prose-a:text-[#0f766e] prose-headings:font-sans prose-headings:tracking-[-0.04em] prose-headings:text-stone-900 prose-p:text-stone-700 prose-li:text-stone-700 prose-img:rounded-2xl">
            <Content />
          </div>
        </div>
        {post.data.galleryImages.length > 0 && (
          <section
            aria-label="Galeri gambar artikel"
            class="grid gap-4 px-4 pb-8 sm:grid-cols-2 sm:px-8 sm:pb-10"
          >
            {post.data.galleryImages.map((image, index) => (
              <img
                src={image}
                alt={`${post.data.title} — gambar ${index + 1}`}
                class="aspect-[4/3] w-full rounded-2xl border border-stone-200 object-cover"
                loading="lazy"
                width="1200"
                height="900"
              />
            ))}
          </section>
        )}
        {recommendedProducts.length > 0 && (
          <section class="border-t border-stone-200 bg-stone-50/70 px-4 pb-8 pt-8 sm:px-8 sm:pb-10 sm:pt-10">
            <h2 class="mb-5 text-2xl font-medium tracking-tight text-stone-900 sm:text-3xl">
              Produk dalam Artikel Ini
            </h2>
            <div class="grid grid-cols-2 gap-3 sm:gap-5">
              {recommendedProducts.map((product) => <ProductCard product={product} />)}
            </div>
          </section>
        )}
        {additionalProducts.length > 0 && (
          <section
            id="produk-terkait"
            class="border-t border-stone-200 px-4 pb-8 pt-8 sm:px-8 sm:pb-10 sm:pt-10"
            data-progressive-products
          >
            <h2 class="mb-2 text-2xl font-medium tracking-tight text-stone-900 sm:text-3xl">
              Produk Terkait Lainnya
            </h2>
            <p class="mb-5 text-sm leading-6 text-stone-600">
              Produk yang sesuai kategori artikel ditampilkan lebih dulu, lalu pilihan lainnya dari katalog.
            </p>
            <div class="grid grid-cols-2 gap-3 sm:gap-5" data-product-grid>
              {additionalProducts.map((product) => (
                <div data-progressive-product>
                  <ProductCard product={product} />
                </div>
              ))}
            </div>
            <div class="mt-6 flex flex-col items-center gap-2">
              <button
                type="button"
                class="rounded-full border border-stone-300 bg-white px-5 py-2.5 text-sm font-medium text-stone-700 transition hover:border-stone-500 hover:text-stone-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-500 focus-visible:ring-offset-2"
                data-load-more
                hidden
              >
                Tampilkan produk lainnya
              </button>
              <p class="text-xs text-stone-500" aria-live="polite" data-product-status></p>
            </div>
            <div class="h-px" aria-hidden="true" data-product-sentinel></div>
          </section>
        )}
      </article>
    </main>

    <Footer />
    <button
      type="button"
      class="fixed bottom-5 right-4 z-40 inline-flex items-center gap-2 rounded-full border border-stone-300 bg-white/95 px-4 py-3 text-sm font-medium text-stone-800 shadow-lg backdrop-blur transition hover:-translate-y-0.5 hover:border-stone-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-500 focus-visible:ring-offset-2 sm:bottom-7 sm:right-7"
      aria-label="Kembali ke bagian atas"
      data-back-to-top
      hidden
    >
      <span aria-hidden="true">↑</span>
      Kembali ke atas
    </button>
    <script>
      const productSection = document.querySelector<HTMLElement>('[data-progressive-products]');
      const backToTopButton = document.querySelector<HTMLButtonElement>('[data-back-to-top]');

      if (productSection) {
        const cards = Array.from(
          productSection.querySelectorAll<HTMLElement>('[data-progressive-product]'),
        );
        const loadMoreButton = productSection.querySelector<HTMLButtonElement>('[data-load-more]');
        const status = productSection.querySelector<HTMLElement>('[data-product-status]');
        const sentinel = productSection.querySelector<HTMLElement>('[data-product-sentinel]');
        const batchSize = 4;

        if (
          cards.length > batchSize &&
          loadMoreButton &&
          status &&
          sentinel &&
          'IntersectionObserver' in window
        ) {
          let visibleCount = batchSize;
          let observer: IntersectionObserver;

          const revealNextBatch = () => {
            visibleCount = Math.min(visibleCount + batchSize, cards.length);
            cards.forEach((card, index) => {
              card.hidden = index >= visibleCount;
            });
            status.textContent = `Menampilkan ${visibleCount} dari ${cards.length} produk.`;

            if (visibleCount === cards.length) {
              loadMoreButton.hidden = true;
              observer.disconnect();
              return;
            }

            observer.unobserve(sentinel);
            observer.observe(sentinel);
          };

          cards.forEach((card, index) => {
            card.hidden = index >= visibleCount;
          });
          loadMoreButton.hidden = false;
          status.textContent = `Menampilkan ${visibleCount} dari ${cards.length} produk. Gulir untuk melihat lainnya.`;
          loadMoreButton.addEventListener('click', revealNextBatch);
          observer = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                revealNextBatch();
              }
            },
            { rootMargin: '400px 0px' },
          );
          observer.observe(sentinel);
        } else if (status) {
          status.textContent = `${cards.length} produk ditampilkan.`;
        }
      }

      if (backToTopButton) {
        const updateBackToTopVisibility = () => {
          backToTopButton.hidden = window.scrollY < 700;
        };

        window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
        updateBackToTopVisibility();
        backToTopButton.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>
  </body>
</html>
