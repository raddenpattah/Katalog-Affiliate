---
import { getCollection, render } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categoryLabels } from '../../data/categories';
import { products } from '../../data/products';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const recommendedProducts = post.data.productIds.map((productId) => {
  const product = products.find(({ id }) => id === productId);

  if (!product) {
    throw new Error(`Blog post "${post.id}" references unknown product "${productId}".`);
  }

  return product;
});
const dateFormatter = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="p:domain_verify" content="63cbf7dea4ba5f9335e79eecc975eb9a" />
    <meta name="description" content={post.data.description} />
    <title>{post.data.title} | Alfeto — Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic</title>
    <meta property="og:image" content={post.data.heroImage} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Alfeto" />
    <meta property="og:title" content={`${post.data.title} | Alfeto`} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:locale" content="id_ID" />
  </head>
  <body class="min-h-screen bg-[#faf9f6] font-sans antialiased text-gray-900">
    <Header />

    <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <article class="overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-[0_18px_60px_-35px_rgba(18,18,18,0.42)]">
        <header class="px-4 pb-8 pt-6 sm:px-8 sm:pb-9 sm:pt-8">
          <div class="flex items-center justify-between gap-4 border-b border-stone-200 pb-5">
            <p class="inline-flex items-center rounded-full border border-[#d7bb72]/60 bg-[#f4efe8] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#5c534d] sm:text-[11px]">
              {categoryLabels[post.data.category]}
            </p>
            <p class="text-[11px] text-stone-500 sm:text-xs">
              {dateFormatter.format(post.data.pubDate)} · {post.data.author}
            </p>
          </div>

          <h1 class="mt-6 text-3xl font-medium leading-[1.05] tracking-[-0.04em] text-stone-900 sm:text-5xl">
            {post.data.title}
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-stone-600 sm:text-lg">
            {post.data.description}
          </p>
          <img
            src={post.data.heroImage}
            alt={`Inspirasi ${post.data.category.toLowerCase()} — ${post.data.title}`}
            class="mt-8 aspect-[4/3] w-full rounded-[1.6rem] border border-stone-200 object-cover shadow-soft sm:aspect-[16/9]"
            width="1200"
            height="900"
          />
        </header>
        <div class="px-4 pb-8 sm:px-8 sm:pb-10">
          <div class="article-shell prose prose-stone max-w-none prose-a:text-[#0f766e] prose-headings:font-serif prose-headings:tracking-[-0.04em] prose-headings:text-stone-900 prose-p:text-stone-700 prose-li:text-stone-700 prose-img:rounded-2xl">
            <Content />
          </div>
        </div>
        {recommendedProducts.length > 0 && (
          <section class="border-t border-stone-200 bg-stone-50/70 px-4 pb-8 pt-8 sm:px-8 sm:pb-10 sm:pt-10">
            <div class="mb-5 flex items-end justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">
                  Inspirasi lanjut
                </p>
                <h2 class="mt-2 text-2xl font-medium tracking-tight text-stone-900 sm:text-3xl">
                  Rekomendasi produk
                </h2>
              </div>
            </div>
            <p class="text-sm leading-6 text-stone-600">
              Pilihan dekorasi yang dibahas dalam artikel ini.
            </p>
            <div class="mt-5 grid grid-cols-2 gap-3 sm:gap-5">
              {recommendedProducts.map((product) => <ProductCard product={product} />)}
            </div>
          </section>
        )}
      </article>
    </main>

    <Footer />
  </body>
</html>
