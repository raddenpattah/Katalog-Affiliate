---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="p:domain_verify" content="63cbf7dea4ba5f9335e79eecc975eb9a" />
    <meta name="description" content="Alfeto | Kurasi & Inspirasi Dekorasi Ruang Aesthetic. Artikel, inspirasi, dan panduan dekorasi." />
    <title>Blog | Alfeto — Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alfeto" />
    <meta property="og:title" content="Blog | Alfeto — Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic" />
    <meta property="og:description" content="Artikel, inspirasi, dan panduan dekorasi dari Alfeto." />
    <meta property="og:locale" content="id_ID" />
  </head>
  <body class="min-h-screen bg-[#fcfbf9] font-sans text-stone-800 antialiased">
    <header class="border-b border-stone-200 bg-white">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" class="font-bold text-stone-900">Alfeto</a>
        <a href="/" class="text-sm font-medium text-stone-600 hover:text-emerald-700">Kembali ke katalog</a>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700">Jurnal dekorasi</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">Blog Alfeto</h1>
      <p class="mt-4 max-w-2xl leading-7 text-stone-600">
        Inspirasi dan panduan praktis untuk membuat rumah terasa makin nyaman dan personal.
      </p>

      <div class="mt-9 grid gap-4">
        {posts.map((post) => (
          <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
            <p class="text-xs text-stone-500">
              {dateFormatter.format(post.data.pubDate)} · {post.data.author}
            </p>
            <h2 class="mt-2 text-xl font-semibold text-stone-900">
              <a class="hover:text-emerald-700" href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="mt-2 text-sm leading-6 text-stone-600">{post.data.description}</p>
            <a
              class="mt-4 inline-flex text-sm font-semibold text-emerald-700 hover:text-emerald-800"
              href={`/blog/${post.id}/`}
            >
              Baca artikel <span aria-hidden="true" class="ml-1">→</span>
            </a>
          </article>
        ))}
      </div>
    </main>
  </body>
</html>
