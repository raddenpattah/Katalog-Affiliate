---
import { getCollection } from 'astro:content';
import { categoryLabels } from '../../data/categories';
import '../../styles/global.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="p:domain_verify" content="63cbf7dea4ba5f9335e79eecc975eb9a" />
    <meta name="description" content="Alfeto | Kurasi & Inspirasi Dekorasi Ruang Aesthetic. Artikel, inspirasi, dan panduan dekorasi." />
    <title>Blog | Alfeto — Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alfeto" />
    <meta property="og:title" content="Blog | Alfeto — Kurasi &amp; Inspirasi Dekorasi Ruang Aesthetic" />
    <meta property="og:description" content="Artikel, inspirasi, dan panduan dekorasi dari Alfeto." />
    <meta property="og:locale" content="id_ID" />
  </head>
  <body class="min-h-screen bg-[#fcfbf9] font-sans antialiased text-gray-900">
    <header class="border-b border-stone-200 bg-white">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6">
        <a href="/" class="font-bold text-stone-900">Alfeto</a>
        <a href="/" class="text-sm font-medium text-stone-600 hover:text-emerald-700">Kembali ke katalog</a>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700">Blog dekorasi</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">Blog Alfeto</h1>
      <p class="mt-4 max-w-2xl leading-7 text-stone-600">
        Inspirasi dan panduan praktis untuk membuat rumah terasa makin nyaman dan personal.
      </p>

      <div class="mt-9 grid gap-4">
        {posts.map((post) => (
          <article class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md sm:grid sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
            <a href={`/blog/${post.id}/`} class="block aspect-[4/3] overflow-hidden bg-stone-100 sm:aspect-auto">
              <img
                src={post.data.heroImage}
                alt=""
                class="h-full w-full object-cover transition duration-500 hover:scale-[1.02]"
                loading="lazy"
                width="1200"
                height="900"
              />
            </a>
            <div class="p-5 sm:p-7">
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-emerald-800">
                {categoryLabels[post.data.category]}
              </p>
              <p class="mt-3 text-xs text-stone-500">
                {dateFormatter.format(post.data.pubDate)} · {post.data.author}
              </p>
              <h2 class="mt-2 text-xl font-semibold leading-snug text-stone-900 sm:text-2xl">
                <a class="hover:text-emerald-800" href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="mt-3 text-sm leading-6 text-stone-600">{post.data.description}</p>
              <a
                class="mt-5 inline-flex text-sm font-semibold text-emerald-800 hover:text-emerald-900"
                href={`/blog/${post.id}/`}
              >
                Baca artikel <span aria-hidden="true" class="ml-1">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </main>
  </body>
</html>
